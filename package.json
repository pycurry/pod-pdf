{
  "name": "pod-pdf",
  "version": "1.0.0",
  "description": "pod-PDF: Enterprise Logistic Label & Multi-Page PDF Microservice",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --external:fsevents --external:aws-crt --external:mock-aws-s3 --external:nock",
    "build:types": "tsc --emitDeclarationOnly",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "build:gui": "cd src/gui && npm install && npm run build"
  },
  "keywords": [
    "pdf",
    "pdfme",
    "thermal-label",
    "barcode",
    "qr-code",
    "datamatrix",
    "logistics",
    "microservice",
    "aws-s3",
    "sqs",
    "kafka"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-sns": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@pdfme/common": "^5.3.18",
    "@pdfme/generator": "^5.3.18",
    "@pdfme/schemas": "^5.3.18",
    "axios": "^1.8.1",
    "bwip-js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.19",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
